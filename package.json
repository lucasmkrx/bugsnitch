{
  "name": "bugsnitch-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension": "pnpm build && node scripts/test-extension.mjs",
    "demo": "node scripts/create-demo.mjs",
    "package": "pnpm build && pnpm --filter bugsnitch package",
    "test:browser": "pnpm build && playwright test",
    "test:coverage": "vitest run --coverage",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "test:package": "pnpm package && pnpm validate:package && node scripts/test-extension.mjs --installed",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
