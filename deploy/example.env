# Generate separate hex values with openssl rand -hex 32.
POSTGRES_PASSWORD=
BUGSNITCH_OWNER_TOKEN=
BUGSNITCH_ORIGIN=http://localhost:8787
BUGSNITCH_HOST_PORT=8787
# Optional email sign-in for a Google Cloud workload with an attached service account.
BUGSNITCH_RECAPTCHA_PROJECT=
BUGSNITCH_RECAPTCHA_SITE_KEY=
BUGSNITCH_RESEND_API_KEY=
BUGSNITCH_EMAIL_FROM=
BUGSNITCH_EMAIL_CODE_KEY=
BUGSNITCH_MCP_TOKEN=
# Optional for a configured hosted MCP tenant and Sentry integration.
MCP_OAUTH_ISSUER=
MCP_OAUTH_INTROSPECTION=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_OWNER_SUBJECT=
SENTRY_CLIENT_SECRET=
# Optional slash command and private Telegram bot webhook credentials.
LINEAR_WEBHOOK_SECRET=
BUGSNITCH_LINEAR_AGENT_TOKEN=
SLACK_SIGNING_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# Optional read-only Linear key scoped to the teams this workspace may link.
BUGSNITCH_LINEAR_API_KEY=
# Required only when including deploy/github-app.yml.
# Set the trusted installation once to enable dashboard project connections.
BUGSNITCH_GITHUB_INSTALLATION_ID=
BUGSNITCH_GITHUB_QUEUE_REPOSITORIES=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
